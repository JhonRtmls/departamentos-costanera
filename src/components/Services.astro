---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const services = [
  {
    icon: `${baseUrl}/icons/calefaccion.png`,
    key: "calefaccion",
  },
  {
    icon: `${baseUrl}/icons/estacionamiento.png`,
    key: "parking",
  },
  {
    icon: `${baseUrl}/icons/cocina.png`,
    key: "cocina",
  },
  {
    icon: `${baseUrl}/icons/cama.png`,
    key: "ropa",
  },
  {
    icon: `${baseUrl}/icons/caja-fuerte.png`,
    key: "caja",
  },
  {
    icon: `${baseUrl}/icons/wifi.png`,
    key: "wifi",
  },
  {
    icon: `${baseUrl}/icons/cuna.png`,
    key: "cuna",
  },
  {
    icon: `${baseUrl}/icons/mucama.png`,
    key: "mucama",
  },
  {
    icon: `${baseUrl}/icons/amenities.png`,
    key: "amenities",
  },
];
---

<section class="services reveal" id="servicios">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t("services.tag")}</span>
      <h2>{t("services.title")}</h2>
      <p>{t("services.subtitle")}</p>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card glass-card">
            <div class="service-icon">
              {s.icon.startsWith("<svg") ? (
                <Fragment set:html={s.icon} />
              ) : (
                <img src={s.icon} alt={t(`services.${s.key}_title` as any)} />
              )}
            </div>
            <h3>{t(`services.${s.key}_title` as any)}</h3>
            <p>{t(`services.${s.key}_desc` as any)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 0;
    background: transparent;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--espresso);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--title-color);
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    transition: var(--transition);
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: var(--espresso);
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--espresso);
    transition: var(--transition);
  }

  .service-icon svg,
  .service-icon img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    /* Improved filter to match #4e2c23 (Espresso) regardless of original color */
    filter: brightness(0) saturate(100%) invert(16%) sepia(20%) saturate(1312%) hue-rotate(324deg) brightness(93%) contrast(90%);
  }

  .service-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.5rem;
    display: grid;
    text-align: center;
  }

  .service-card p {
    font-size: 0.9rem;
    color: var(--text-main);
    line-height: 1.6;
    display: grid;
    text-align: center;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
