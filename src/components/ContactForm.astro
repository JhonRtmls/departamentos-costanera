---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="contact reveal" id="contacto">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-text">
        <span class="section-tag">{t("contact.tag")}</span>
        <h2>{t("contact.title")}</h2>
        <p>{t("contact.subtitle")}</p>

        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span>{t("contact.address")}</span>
          </div>
          <div class="contact-item">
            <span class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span>{t("contact.phone")}</span>
          </div>
          <div class="contact-item">
            <span class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <span>{t("contact.email")}</span>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="contact-social">
          <a
            href="https://www.facebook.com/departamentoscostanera"
            class="btn-iridescent"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            style="padding: 0.6rem 1.2rem; font-size: 0.85rem;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
            <span>Facebook</span>
          </a>
          <a
            href="https://www.instagram.com/departamentoscostanera"
            class="btn-iridescent"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            style="padding: 0.6rem 1.2rem; font-size: 0.85rem;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <form class="contact-form glass-card" id="booking-form" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="checkin">{t("contact.form_checkin")}</label>
            <input type="date" id="checkin" name="checkin" required />
          </div>
          <div class="form-group">
            <label for="checkout">{t("contact.form_checkout")}</label>
            <input type="date" id="checkout" name="checkout" required />
          </div>
        </div>
        <div class="form-row guests-row">
          <div class="form-group">
            <label for="adults">Adultos / Adults</label>
            <select id="adults" name="adults">
              <option value="1">1</option>
              <option value="2" selected>2</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>
          </div>
          <div class="form-group">
            <label for="children">Niños / Children</label>
            <select id="children" name="children">
              <option value="0" selected>0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
            </select>
          </div>
          <div class="form-group">
            <label for="infants">Bebés / Infants</label>
            <select id="infants" name="infants">
              <option value="0" selected>0</option>
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn-iridescent">
          <span>{lang === 'es' ? 'Consultar Disponibilidad' : lang === 'en' ? 'Check Availability' : '检查可用性'}</span>
        </button>
      </form>

      <script>
        const bookingForm = document.getElementById('booking-form');
        if (bookingForm) {
          bookingForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const checkin = (document.getElementById('checkin') as HTMLInputElement).value;
            const checkout = (document.getElementById('checkout') as HTMLInputElement).value;
            const adults = (document.getElementById('adults') as HTMLSelectElement).value;
            const children = (document.getElementById('children') as HTMLSelectElement).value;
            const infants = (document.getElementById('infants') as HTMLSelectElement).value;
            
            if (!checkin || !checkout) {
              const msg = {
                es: "Por favor selecciona las fechas",
                en: "Please select dates",
                zh: "请选择日期"
              };
              // @ts-ignore
              alert(msg[document.documentElement.lang] || msg.en);
              return;
            }
            
            const baseUrl = "https://direct-book.com/properties/departamentoscostaneradirect";
            const url = `${baseUrl}?locale=${document.documentElement.lang}&items[0][adults]=${adults}&items[0][children]=${children}&items[0][infants]=${infants}&currency=USD&checkInDate=${checkin}&checkOutDate=${checkout}&trackPage=yes`;
            
            window.open(url, '_blank');
          });
          // Trigger date picker on click
      const dateInputs = bookingForm.querySelectorAll('input[type="date"]');
      dateInputs.forEach(input => {
        input.addEventListener('click', () => {
          try {
            (input as any).showPicker();
          } catch (e) {
            console.log('showPicker not supported');
          }
        });
      });
    }
      </script>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 6rem 0;
    background: transparent;
    content-visibility: auto;
    contain-intrinsic-size: 0 600px;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: start;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contact-text h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--title-color);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .contact-text p {
    color: var(--text-main);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--espresso);
    opacity: 0.9;
  }

  .contact-form {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .guests-row {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 480px) {
    .guests-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--espresso);
    background: #ffffff;
    border: 1.5px solid rgba(78, 44, 35, 0.1);
    transition: var(--transition);
    outline: none;
    cursor: pointer;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--espresso);
    box-shadow: 0 0 0 4px rgba(78, 44, 35, 0.08);
  }



  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  /* ── Social buttons ── */
  .contact-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }


</style>
