---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="contact reveal" id="contacto">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-text">
        <span class="section-tag">{t("contact.tag")}</span>
        <h2>{t("contact.title")}</h2>
        <p>{t("contact.subtitle")}</p>

        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-icon">📍</span>
            <span>{t("contact.address")}</span>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <span>{t("contact.phone")}</span>
          </div>
          <div class="contact-item">
            <span class="contact-icon">✉️</span>
            <span>{t("contact.email")}</span>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="contact-social">
          <a
            href="https://www.facebook.com/departamentoscostanera"
            class="social-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
            Facebook
          </a>
          <a
            href="https://www.instagram.com/departamentoscostanera"
            class="social-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            Instagram
          </a>
        </div>
      </div>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="form-group">
          <label for="name">{t("contact.form_name")}</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder={t("contact.form_name_placeholder") as string}
            required
          />
        </div>
        <div class="form-group">
          <label for="email">{t("contact.form_email")}</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder={t("contact.form_email_placeholder") as string}
            required
          />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="checkin">{t("contact.form_checkin")}</label>
            <input type="date" id="checkin" name="checkin" />
          </div>
          <div class="form-group">
            <label for="checkout">{t("contact.form_checkout")}</label>
            <input type="date" id="checkout" name="checkout" />
          </div>
        </div>
        <div class="form-group">
          <label for="message">{t("contact.form_message")}</label>
          <textarea
            id="message"
            name="message"
            rows={4}
            placeholder={t("contact.form_message_placeholder") as string}
          ></textarea>
        </div>
        <button type="submit" class="btn-submit"
          >{t("contact.form_submit")}</button
        >
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 6rem 0;
    background: transparent;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: start;
  }

  .section-tag {
    display: inline-block;
    color: var(--espresso);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contact-text h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--title-color);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .contact-text p {
    color: var(--text-main);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .contact-icon {
    font-size: 1.2rem;
  }

  .contact-form {
    background: rgba(78, 44, 35, 0.05);
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid rgba(78, 44, 35, 0.1);
    box-shadow: 0 20px 40px rgba(78, 44, 35, 0.05);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-main);
    background: #ffffff;
    border: 1.5px solid rgba(11, 18, 21, 0.08);
    transition: var(--transition);
    outline: none;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--espresso);
    box-shadow: 0 0 0 4px rgba(78, 44, 35, 0.08);
  }

  .btn-submit {
    background: var(--espresso);
    color: var(--soft-apricot);
    border: none;
    padding: 1rem;
    border-radius: 50px;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 4px 12px rgba(78, 44, 35, 0.15);
  }

  .btn-submit:hover {
    background: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(78, 44, 35, 0.3);
  }

  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  /* ── Social buttons ── */
  .contact-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 50px;
    border: 1.5px solid rgba(11, 18, 21, 0.12);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition);
  }

  .social-btn:hover {
    border-color: var(--espresso);
    color: var(--espresso);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(78, 44, 35, 0.1);
  }
</style>
