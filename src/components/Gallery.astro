---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import GalleryReact from "./GalleryReact";
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const slideNames = ['slide1.webp', 'slide2.webp', 'slide3.webp', 'slide4.webp', 'slide5.webp', 'slide6.webp'];

const images = slideNames.map((name, index) => ({
  src: `${baseUrl}/gallery/${name}`,
  alt: t(`gallery.alt_${index + 1}`) as string,
  caption: t(`gallery.caption_${index + 1}`) as string,
}));
---

<GalleryReact
  client:load
  images={images}
  tag={t("gallery.tag") as string}
  title={t("gallery.title") as string}
  subtitle={t("gallery.subtitle") as string}
  desc={t("gallery.desc") as string}
/>
