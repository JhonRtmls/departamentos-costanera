---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import GalleryReact from "./GalleryReact";
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Resolve slides from assets
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/slide*.{webp,jpg}');

const resolveSlide = async (name: string, index: number) => {
  const path = `/src/assets/gallery/${name}`;
  if (allImages[path]) {
    const img = await allImages[path]();
    const optimized = await getImage({ src: img.default, format: 'webp', width: 1200 });
    return {
      src: optimized.src,
      alt: t(`gallery.alt_${index + 1}`) as string,
      caption: t(`gallery.caption_${index + 1}`) as string,
    };
  }
  return null;
};

const imagePromises = [
  resolveSlide('slide1.webp', 0),
  resolveSlide('slide2.webp', 1),
  resolveSlide('slide3.webp', 2),
  resolveSlide('slide4.webp', 3),
  resolveSlide('slide5.webp', 4),
  resolveSlide('slide6.webp', 5), // Checking if it's webp or jpg
];

const images = (await Promise.all(imagePromises)).filter(Boolean);
---

<GalleryReact
  client:load
  images={images}
  tag={t("gallery.tag") as string}
  title={t("gallery.title") as string}
  subtitle={t("gallery.subtitle") as string}
  desc={t("gallery.desc") as string}
/>
