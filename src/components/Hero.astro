---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero" id="inicio">
  <video
    class="hero-bg-video"
    autoplay
    muted
    loop
    playsinline
    poster={`${baseUrl}/hero.webp`}
  >
    <source src={`${baseUrl}/hero.webm`} type="video/webm" />
  </video>
  <div class="hero-bg-overlay"></div>
  <div class="hero-content">
    <span class="hero-badge">{t("hero.badge")}</span>
    <h1 class="hero-title">{t("hero.title")}</h1>
    <p class="hero-subtitle">{t("hero.subtitle")}</p>
    <div class="hero-actions">
      <a
        href="https://direct-book.com/properties/departamentoscostaneradirect"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-iridescent"><span>{t("hero.cta_primary")}</span></a
      >
    </div>
  </div>

  <!-- Booking Bar -->
  <div class="booking-bar-wrapper reveal" style="animation-delay: 0.3s;">
    <form class="booking-bar glass-card" id="hero-booking-form">
      <div class="booking-field">
        <label for="h-checkin">{t("contact.form_checkin")}</label>
        <input type="date" id="h-checkin" required />
      </div>
      <div class="booking-divider"></div>
      <div class="booking-field">
        <label for="h-checkout">{t("contact.form_checkout")}</label>
        <input type="date" id="h-checkout" required />
      </div>
      <div class="booking-divider"></div>
      <div class="booking-field">
        <label for="h-adults">{t("hero.adults")}</label>
        <select id="h-adults">
          <option value="1">1</option>
          <option value="2" selected>2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>
      <div class="booking-divider"></div>
      <div class="booking-field">
        <label for="h-children">{t("hero.children")}</label>
        <select id="h-children">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>
      <button
        type="submit"
        class="btn-iridescent booking-submit"
        aria-label={t("hero.search")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
          ></path></svg
        >
      </button>
    </form>
  </div>

  <script>
    const heroForm = document.getElementById("hero-booking-form");
    if (heroForm) {
      heroForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const checkin = (
          document.getElementById("h-checkin") as HTMLInputElement
        ).value;
        const checkout = (
          document.getElementById("h-checkout") as HTMLInputElement
        ).value;
        const adults = (
          document.getElementById("h-adults") as HTMLSelectElement
        ).value;
        const children = (
          document.getElementById("h-children") as HTMLSelectElement
        ).value;

        if (!checkin || !checkout) return;

        const baseUrl =
          "https://direct-book.com/properties/departamentoscostaneradirect";
        const url = `${baseUrl}?locale=${document.documentElement.lang}&items[0][adults]=${adults}&items[0][children]=${children}&currency=USD&checkInDate=${checkin}&checkOutDate=${checkout}&trackPage=yes`;

        window.open(url, "_blank");
      });

      // Trigger date picker on click
      const dateInputs = heroForm.querySelectorAll('input[type="date"]');
      dateInputs.forEach((input) => {
        input.addEventListener("click", () => {
          try {
            (input as any).showPicker();
          } catch (e) {
            console.log("showPicker not supported");
          }
        });
      });
    }
  </script>

  <div class="hero-scroll">
    <span></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--primary);
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(78, 44, 35, 0.1) 0%,
      rgba(226, 114, 91, 0.1) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
    max-width: 800px;
    animation: fadeUp 0.9s ease both;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-badge {
    display: inline-block;
    background: rgba(78, 44, 35, 0.1);
    border: 1px solid rgba(78, 44, 35, 0.3);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Booking Bar ── */
  .booking-bar-wrapper {
    position: absolute;
    bottom: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 900px;
    z-index: 10;
  }

  .booking-bar {
    display: flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    gap: 1.5rem;
    border-radius: 100px !important; /* Force pill shape */
  }

  .booking-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .booking-field label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--white);
    opacity: 0.9;
  }

  .booking-divider {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.15);
  }

  .booking-field input,
  .booking-field select {
    background: transparent;
    border: none;
    padding: 0.5rem 0;
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 600;
    font-family: inherit;
    outline: none;
    cursor: pointer;
    width: 100%;
    transition: var(--transition);
  }

  /* Style dropdown options specifically for readability */
  .booking-field select option {
    background-color: #ffffff;
    color: var(--espresso);
  }

  .booking-field input:focus,
  .booking-field select:focus {
    color: var(--soft-apricot);
  }

  .booking-field input:focus-visible,
  .booking-field select:focus-visible {
    outline: 2.5px solid var(--soft-apricot);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .booking-submit {
    width: 50px;
    height: 50px;
    padding: 0 !important;
    border-radius: 50% !important;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .booking-bar-wrapper {
      position: relative;
      bottom: auto;
      transform: none;
      left: auto;
      margin: 2rem auto 0 auto;
      width: 100%;
    }

    .booking-bar {
      flex-direction: column;
      border-radius: 24px !important;
      padding: 2rem;
      align-items: stretch;
      gap: 1rem;
    }

    .booking-divider {
      width: 100%;
      height: 1px;
    }

    .booking-submit {
      width: 100%;
      height: 50px;
      border-radius: 50px !important;
    }

    .hero {
      flex-direction: column;
      padding-top: 120px;
      padding-bottom: 60px;
      min-height: auto;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }

  @media (max-width: 480px) {
    .booking-bar {
      padding: 1.25rem;
      gap: 0.75rem;
    }

    .hero-content {
      padding: 1.5rem 1rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 7vw, 2.5rem);
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
