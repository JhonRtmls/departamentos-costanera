---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const attractions = [
  {
    image: `${baseUrl}/atracciones/Museo-Sara-Brown-Punta-Arenas.png`,
    title: t("attractions.item1_title"),
    dist: t("attractions.item1_dist"),
    desc: t("attractions.item1_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Museo-Nao-Victoria-Magallanes-Chile.png`,
    title: t("attractions.item2_title"),
    dist: t("attractions.item2_dist"),
    desc: t("attractions.item2_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Monumento-Al-Ovejero-Punta-Arenas-Chile.png`,
    title: t("attractions.item3_title"),
    dist: t("attractions.item3_dist"),
    desc: t("attractions.item3_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Cementerio-Municipal-Atracciones-Punta-Arenas.png`,
    title: t("attractions.item4_title"),
    dist: t("attractions.item4_dist"),
    desc: t("attractions.item4_desc"),
  },
];
---

<section class="attractions" id="atracciones">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">{t("attractions.tag")}</span>
      <h2 class="section-title">{t("attractions.title")}</h2>
      <p class="section-subtitle">{t("attractions.subtitle")}</p>
    </div>

    <div class="attractions-grid">
      {attractions.map((item, index) => (
        <div class="attraction-card reveal" style={`animation-delay: ${index * 0.1}s;`}>
          <div class="card-image">
            <img src={item.image} alt={item.title} loading="lazy" />
          </div>
          <div class="card-content">
            <h3>{item.title}</h3>
            <span class="distance">{item.dist}</span>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="attractions-cta reveal">
      <a href="https://direct-book.com/properties/departamentoscostaneradirect" target="_blank" class="btn-iridescent">
        <span class="btn-text">{t("hero.cta_primary")}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .attractions {
    padding: 8rem 0;
    position: relative;
    background: transparent;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--espresso);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--espresso);
    margin-bottom: 1.5rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-main);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    opacity: 0.8;
  }

  .attractions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .attraction-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: var(--transition);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .attraction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--espresso);
    margin-bottom: 0.25rem;
  }

  .distance {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .card-content p {
    font-size: 0.9rem;
    color: var(--text-main);
    line-height: 1.6;
    opacity: 0.9;
  }

  .attractions-cta {
    display: flex;
    justify-content: flex-start; /* Aligned left as in the reference image */
  }

  /* Button styles duplicated or referenced from global/hero */
  .btn-iridescent {
    --active: 0;
    --hover: 0;
    position: relative;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    background: var(--burnt-peach);
    color: white;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-iridescent:hover {
    --hover: 1;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(226, 114, 91, 0.4);
  }

  @media (max-width: 1024px) {
    .attractions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .attractions-grid {
      grid-template-columns: 1fr;
    }
    .attractions {
      padding: 5rem 0;
    }
    .section-header {
      margin-bottom: 3rem;
    }
  }
</style>
