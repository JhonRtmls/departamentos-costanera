---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const attractions = [
  {
    image: `${baseUrl}/atracciones/Museo-Sara-Brown-Punta-Arenas.webp`,
    title: t("attractions.item1_title"),
    dist: t("attractions.item1_dist"),
    desc: t("attractions.item1_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Museo-Nao-Victoria-Magallanes-Chile.webp`,
    title: t("attractions.item2_title"),
    dist: t("attractions.item2_dist"),
    desc: t("attractions.item2_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Monumento-Al-Ovejero-Punta-Arenas-Chile.webp`,
    title: t("attractions.item3_title"),
    dist: t("attractions.item3_dist"),
    desc: t("attractions.item3_desc"),
  },
  {
    image: `${baseUrl}/atracciones/Cementerio-Municipal-Atracciones-Punta-Arenas.webp`,
    title: t("attractions.item4_title"),
    dist: t("attractions.item4_dist"),
    desc: t("attractions.item4_desc"),
  },
];
---

<section class="attractions" id="atracciones">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">{t("attractions.tag")}</span>
      <h2 class="section-title">{t("attractions.title")}</h2>
      <p class="section-subtitle">{t("attractions.subtitle")}</p>
    </div>

    <div class="attractions-grid">
      {
        attractions.map((item, index) => (
          <div
            class="attraction-card glass-card reveal"
            style={`animation-delay: ${index * 0.1}s;`}
          >
            <div class="card-image">
              <img src={item.image} alt={item.title} loading="lazy" />
            </div>
            <div class="card-content">
              <h3>{item.title}</h3>
              <div class="distance-tag">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </>
                </svg>
                <span>{item.dist}</span>
              </div>
              <p>{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .attractions {
    padding: 8rem 0;
    position: relative;
    background: transparent;
    content-visibility: auto;
    contain-intrinsic-size: 0 700px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--title-color);
    margin-bottom: 1.5rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-main);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    opacity: 0.8;
  }

  .attractions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem; /* Slightly reduced gap to give more room to text */
    margin-bottom: 5rem;
    align-items: stretch;
  }

  .attraction-card {
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    padding: 1rem;
    border-radius: 28px;
  }

  .attraction-card:hover {
    transform: translateY(-10px);
    border-color: var(--soft-apricot);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .attraction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 0 0.5rem 0.5rem 0.5rem;
  }

  .card-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--title-color);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .distance-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--soft-apricot);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .card-content p {
    font-size: 0.875rem; /* Slightly smaller for long texts */
    color: var(--text-main);
    line-height: 1.6;
    opacity: 0.9;
  }

  @media (max-width: 1200px) {
    .attractions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .attractions-grid {
      grid-template-columns: 1fr;
    }
    .attractions {
      padding: 5rem 0;
    }
  }

  /* Button styles duplicated or referenced from global/hero */
  .btn-iridescent {
    --active: 0;
    --hover: 0;
    position: relative;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    background: var(--burnt-peach);
    color: white;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-iridescent:hover {
    --hover: 1;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(226, 114, 91, 0.4);
  }

  @media (max-width: 1024px) {
    .attractions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .attractions-grid {
      grid-template-columns: 1fr;
    }
    .attractions {
      padding: 5rem 0;
    }
    .section-header {
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 480px) {
    .attractions {
      padding: 3.5rem 0;
    }
    .attraction-card {
      padding: 0.75rem;
    }
    .card-content {
      padding: 0 0.25rem 0.25rem;
    }
    .card-content h3 {
      font-size: 1.05rem;
    }
  }
</style>
