---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="policies reveal" id="politicas">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t("policies.tag")}</span>
      <h2>{t("policies.title")}</h2>
    </div>

    <div class="rates-wrapper reveal">
      <div class="rates-card glass-card">
        <div class="rates-header">
          <div class="rates-icon">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>{t("policies.rates_title")}</h3>
        </div>
        <div class="table-responsive">
          <table class="rates-table">
            <thead>
              <tr>
                <th>{t("policies.table_guests")}</th>
                <th>{t("policies.table_price")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{t("policies.rates_4")}</td>
                <td class="price">$100.000 CLP</td>
              </tr>
              <tr>
                <td>{t("policies.rates_3")}</td>
                <td class="price">$90.000 CLP</td>
              </tr>
              <tr>
                <td>{t("policies.rates_2_1")}</td>
                <td class="price">$80.000 CLP</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="policies-grid">
      <!-- Payments & VAT -->
      <div class="policy-card glass-card reveal">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        </div>
        <h3>{t("policies.payment_title")}</h3>
        <p>{t("policies.payment_desc")}</p>
        
        <div class="vat-exemption">
          <span class="vat-badge">{t("policies.vat_exemption_title")}</span>
          <p class="vat-text">{t("policies.vat_exemption_desc")}</p>
        </div>

        <div class="payment-icons">
           <img src={`${import.meta.env.BASE_URL}paylogos.svg`} alt="Métodos de pago" class="payment-logo-full" />
        </div>
      </div>

      <!-- Times -->
      <div class="policy-card glass-card reveal">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>{t("policies.check_title")}</h3>
        <ul>
          <li>{t("policies.check_in")}</li>
          <li>{t("policies.check_out")}</li>
        </ul>
      </div>

      <!-- House Rules -->
      <div class="policy-card glass-card reveal">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 4l9 5.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 21v-9h6v9"/></svg>
        </div>
        <h3>{t("policies.rules_title")}</h3>
        <ul>
          <li>{t("policies.no_pets")}</li>
          <li>{t("policies.no_smoking")}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .policies {
    padding: 6rem 0;
    background: #fdfdfd;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--espresso);
  }

  .rates-wrapper {
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .rates-card {
    padding: 2.5rem;
    overflow: hidden;
  }

  .rates-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .rates-icon {
    width: 48px;
    height: 48px;
    background: rgba(78, 44, 35, 0.05);
    color: var(--espresso);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rates-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--espresso);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .rates-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .rates-table th {
    padding: 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    border-bottom: 2px solid rgba(78, 44, 35, 0.1);
  }

  .rates-table td {
    padding: 1.25rem 1rem;
    font-size: 1.05rem;
    color: var(--text-main);
    border-bottom: 1px solid rgba(78, 44, 35, 0.05);
  }

  .rates-table tr:last-child td {
    border-bottom: none;
  }

  .rates-table .price {
    font-weight: 700;
    color: var(--espresso);
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .policies-grid {
      grid-template-columns: 1fr;
    }
    .rates-card {
      padding: 1.5rem;
    }
  }

  .policy-card {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: var(--transition);
  }

  .policy-card:hover {
    transform: translateY(-8px);
    border-color: var(--espresso);
  }

  .vat-exemption {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(78, 44, 35, 0.03);
    border-radius: 12px;
    border: 1px dashed rgba(78, 44, 35, 0.1);
  }

  .vat-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
    background: var(--espresso);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }

  .vat-text {
    font-size: 0.8rem !important;
    line-height: 1.4 !important;
    opacity: 0.8;
  }

  .policy-icon {
    width: 60px;
    height: 60px;
    background: rgba(226, 114, 91, 0.1);
    color: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .policy-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--espresso);
    margin-bottom: 1rem;
  }

  .policy-card p, 
  .policy-card ul {
    color: var(--text-main);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .policy-card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .payment-icons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .payment-logo-full {
    height: 40px;
    width: auto;
    max-width: 100%;
    filter: grayscale(1) opacity(0.7);
    transition: var(--transition);
  }

  .policy-card:hover .payment-logo-full {
    filter: grayscale(0) opacity(1);
  }

  @media (max-width: 768px) {
    .policies {
      padding: 4rem 0;
    }
    
    .policy-card {
      padding: 2rem;
    }
  }
</style>
