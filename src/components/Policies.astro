---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const l = (path: string) => {
  return `${baseUrl}/${lang}${path}`.replace(/\/+$/, "/");
};
---

<section class="policies reveal" id="politicas">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t("policies.tag")}</span>
      <h2>{t("policies.title")}</h2>
    </div>

    <div class="rates-wrapper reveal">
      <div class="rates-card glass-card">
        <div class="rates-header">
          <div class="rates-icon">

            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>{t("policies.rates_title")}</h3>
        </div>
        <div class="table-responsive">
          <table class="rates-table">
            <thead>
              <tr>
                <th>{t("policies.table_guests")}</th>
                <th>{t("policies.low_season")}</th>
                <th>{t("policies.high_season")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{t("policies.rates_4")}</td>
                <td class="price">{t("policies.price_4_low")}</td>
                <td class="price high-season">{t("policies.price_4_high")}</td>
              </tr>
              <tr>
                <td>{t("policies.rates_3")}</td>
                <td class="price">{t("policies.price_3_low")}</td>
                <td class="price high-season">{t("policies.price_3_high")}</td>
              </tr>
              <tr>
                <td>{t("policies.rates_2_1")}</td>
                <td class="price">{t("policies.price_2_low")}</td>
                <td class="price high-season">{t("policies.price_2_high")}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="policies-grid">
      <!-- Payments -->
      <div class="policy-card glass-card reveal">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        </div>
        <h3>{t("policies.payment_title")}</h3>
        <p>{t("policies.payment_desc")}</p>
        <p class="policy-note">{t("policies.business_note")}</p>
        <div class="payment-icons">
          <img src={`${baseUrl}/paylogos.svg`} alt="Métodos de pago" class="payment-logo-full" />
        </div>
      </div>

      <!-- VAT Exemption -->
      <div class="policy-card glass-card reveal" style="animation-delay: 0.1s;">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4c0-.5.2-1 .5-1.5s.8-.5 1.5-.5h8c.7 0 1.2.2 1.5.5s.5 1 .5 1.5v18l-4-2-4 2-4-2Z"/><path d="M18 12h4"/><path d="M18 16h4"/><path d="M18 8h4"/></svg>
        </div>
        <h3>{t("policies.vat_exemption_title")}</h3>
          <p class="vat-text-main">{t("policies.vat_exemption_desc")}</p>
          <p class="policy-note">{t("policies.dollar_note")}</p>
      </div>

      <!-- Times -->
      <div class="policy-card glass-card reveal" style="animation-delay: 0.2s;">
        <div class="policy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>{t("policies.check_title")}</h3>
        <ul class="times-list">
          <li>
            <span class="time-label">{t("policies.check_in")}</span>
            <span class="early-check">{t("policies.early_check_in")}</span>
          </li>
          <li>
            <span class="time-label">{t("policies.check_out")}</span>
          </li>
        </ul>
        <p class="time-note">{t("policies.check_note")}</p>
      </div>
    </div>

    <div class="policies-footer">
      <a href={l("/politicas")} class="btn-iridescent"><span>{t("policies.see_all")}</span></a>
    </div>
  </div>
</section>

<style>
  .policies {
    padding: 6rem 0;
    background: transparent;
    content-visibility: auto;
    contain-intrinsic-size: 0 800px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
  }

  .rates-wrapper {
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .rates-card {
    padding: 2.5rem;
    overflow: hidden;
  }

  .rates-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .rates-icon {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rates-icon svg {
    width: 48px;
    height: 48px;
  }

  .rates-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--title-color);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .rates-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .rates-table th {
    padding: 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  }

  .rates-table td {
    padding: 1.25rem 1rem;
    font-size: 1.05rem;
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .rates-table tr:last-child td {
    border-bottom: none;
  }

  .rates-table .price {
    font-weight: 700;
    color: #ffffff;
  }

  .high-season {
    color: #ffffff !important;
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .policies-grid {
      grid-template-columns: 1fr;
    }
    .rates-card {
      padding: 1.5rem;
    }
  }

  .policy-card {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: var(--transition);
  }

  .policy-card:hover {
    transform: translateY(-8px);
    border-color: var(--espresso);
  }

  .vat-text-main {
    font-size: 0.9rem !important;
    line-height: 1.5 !important;
    color: var(--text-main);
    opacity: 0.9;
    margin-bottom: 0.75rem;
  }

  .policy-note {
    font-size: 0.85rem;
    color: #ffffff;
    margin-top: 0.5rem;
    font-weight: 500;
    opacity: 0.8;
  }

  .times-list {
    width: 100%;
    margin-top: 0.5rem;
  }

  .times-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(78, 44, 35, 0.05);
  }

  .times-list li:last-child {
    border-bottom: none;
  }

  .time-label {
    font-weight: 700;
    color: #ffffff;
    font-size: 1.05rem;
  }

  .early-check {
    font-size: 0.9rem;
    color: #ffffff;
    font-weight: 500;
    opacity: 0.8;
  }

  .time-note {
    margin-top: 1rem;
    font-size: 0.85rem !important;
    font-style: italic;
    opacity: 0.8;
    color: var(--text-main);
  }

  .policy-icon {
    color: #ffffff;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .policy-icon svg {
    width: 48px; /* Same size as service icons */
    height: 48px;
  }

  .policy-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--title-color);
    margin-bottom: 1rem;
  }

  .policy-card p, 
  .policy-card ul {
    color: var(--text-main);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .policy-card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .payment-icons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .payment-logo-full {
    height: 40px;
    width: auto;
    max-width: 100%;
    filter: grayscale(1) opacity(0.7);
    transition: var(--transition);
  }

  .policy-card:hover .payment-logo-full {
    filter: grayscale(0) opacity(1);
  }

  .policies-footer {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .policies {
      padding: 4rem 0;
    }
    .policy-card {
      padding: 2rem;
    }
  }

  @media (max-width: 480px) {
    .policies {
      padding: 3rem 0;
    }
    .rates-card {
      padding: 1rem;
    }
    .rates-header h3 {
      font-size: 1.2rem;
    }
    .policy-card {
      padding: 1.5rem 1rem;
    }
    .rates-table td,
    .rates-table th {
      padding: 0.75rem 0.5rem;
      font-size: 0.85rem;
    }
  }
</style>
