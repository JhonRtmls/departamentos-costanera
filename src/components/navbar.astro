---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { languages } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Utility to prepend base and lang to paths
const l = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${lang}${path}`.replace(/\/+$/, "/");
};

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="navbar">
  <div class="container navbar-content">
    <a href={l("/")} class="logo">
      <img src={`${baseUrl}/logo%20blanco.svg`} alt="logo costanera" />
    </a>

    <nav class="nav-links">
      <ul>
        <li><a href={l("/")}>{t("nav.inicio")}</a></li>
        <li><a href={l("/departamentos")}>{t("nav.departamentos")}</a></li>
        <li><a href={l("/que-hacer")}>{t("nav.que_hacer")}</a></li>
        <li><a href="#servicios">{t("nav.servicios")}</a></li>
        <li><a href={l("/contacto")}>{t("nav.contacto")}</a></li>
      </ul>
    </nav>

    <div class="nav-actions">
      <a
        href="https://direct-book.com/properties/departamentoscostaneradirect"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-iridescent"><span>{t("nav.reservar_ahora")}</span></a
      >

      <div class="lang-dropdown">
        <button
          class="lang-selected"
          id="lang-btn"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="current-lang">{lang.toUpperCase()}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="chevron"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="lang-menu" id="lang-menu">
          {
            Object.entries(languages).map(([code, label]) => {
              // Reemplazamos el idioma actual por el nuevo en la URL
              const parts = Astro.url.pathname.split("/");
              const langIndex = parts.findIndex((p) => p === lang);
              if (langIndex !== -1) parts[langIndex] = code;
              const newPath = parts.join("/") || "/";

              return (
                <a href={newPath} class={lang === code ? "active" : ""}>
                  <span class="lang-code">{code.toUpperCase()}</span>
                  <span class="lang-label">{label}</span>
                </a>
              );
            })
          }
        </div>
      </div>
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Overlay Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav-links">
      <ul>
        <li><a href={l("/")}>{t("nav.inicio")}</a></li>
        <li><a href={l("/departamentos")}>{t("nav.departamentos")}</a></li>
        <li><a href={l("/que-hacer")}>{t("nav.que_hacer")}</a></li>
        <li><a href="#servicios">{t("nav.servicios")}</a></li>
        <li><a href={l("/contacto")}>{t("nav.contacto")}</a></li>
      </ul>
    </nav>
    <div class="mobile-menu-footer">
      <a
        href="https://direct-book.com/properties/departamentoscostaneradirect"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-iridescent mobile-btn-reserva"><span>{t("nav.reservar_ahora")}</span></a
      >
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--navbar-height);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--glass-border);
    z-index: 1000;
    display: flex;
    align-items: center;
    transition: var(--transition);
    box-shadow: var(--glass-shadow);
  }

  .navbar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .nav-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--soft-apricot);
    filter: brightness(1.2);
  }

  .logo img {
    height: 40px;
    width: auto;
    filter: brightness(0) invert(1); /* Force logo to white if it's an SVG icon */
  }

  .nav-links ul {
    display: flex;
    gap: 2.5rem;
  }

  .nav-links a {
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    position: relative;
    letter-spacing: 0.05em;
  }

  .nav-links a:hover {
    color: var(--soft-apricot);
  }

  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--soft-apricot);
    transition: var(--transition);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .lang-dropdown {
    position: relative;
  }

  .lang-selected {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.4rem 0.8rem;
    border-radius: 50px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    transition: var(--transition);
  }

  .lang-selected:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--soft-apricot);
  }

  .lang-selected:hover {
    background: rgba(11, 18, 21, 0.08);
    border-color: var(--accent);
  }

  .chevron {
    transition: transform 0.3s ease;
  }

  .lang-dropdown:hover .chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 160px;
    background: #ffffff;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: var(--transition);
    z-index: 1001;
  }

  .lang-dropdown:hover .lang-menu,
  .lang-selected[aria-expanded="true"] + .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-selected[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .lang-menu a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: var(--transition);
  }

  .lang-menu a:hover {
    background: rgba(59, 130, 246, 0.05);
    color: var(--accent);
  }

  .lang-menu a.active {
    background: rgba(11, 18, 21, 0.03);
    color: var(--primary);
    font-weight: 600;
  }

  .lang-code {
    font-size: 0.75rem;
    padding: 2px 4px;
    background: rgba(11, 18, 21, 0.05);
    border-radius: 4px;
    color: var(--primary);
  }

  .lang-label {
    flex: 1;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: var(--transition);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .btn-primary {
      display: none;
    }
  }

  /* ── Mobile Menu Styles ── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: var(--navbar-height);
    left: 0;
    width: 100%;
    height: 0;
    background: #0f0a09; /* Matching the dark start of the gradient */
    overflow: hidden;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    flex-direction: column;
    z-index: 999;
    border-bottom: 0px solid var(--espresso);
  }

  .mobile-menu.active {
    display: flex;
    height: calc(100vh - var(--navbar-height));
    border-bottom-width: 1px;
  }

  .mobile-nav-links {
    padding: 2rem;
  }

  .mobile-nav-links ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .mobile-nav-links a {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
  }

  .mobile-menu-footer {
    margin-top: auto;
    padding: 2rem;
    border-top: 1px solid rgba(78, 44, 35, 0.1);
  }

  .mobile-btn-reserva {
    display: flex !important;
    justify-content: center;
    width: 100%;
    text-align: center;
  }

  /* Burger animation */
  .mobile-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  // Simple scroll effect for navbar removed as per request for consistent background

  // Language dropdown toggle
  const langBtn = document.getElementById("lang-btn");
  if (langBtn) {
    langBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const expanded = langBtn.getAttribute("aria-expanded") === "true";
      langBtn.setAttribute("aria-expanded", (!expanded).toString());
    });
  }

  // Mobile menu toggle
  const mobileToggle = document.getElementById("mobile-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener("click", () => {
      const expanded = mobileToggle.getAttribute("aria-expanded") === "true";
      mobileToggle.setAttribute("aria-expanded", (!expanded).toString());
      mobileMenu.classList.toggle("active");
      
      // Prevent body scroll when menu is open
      document.body.style.overflow = !expanded ? "hidden" : "";
    });

    // Close menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileToggle.setAttribute("aria-expanded", "false");
        mobileMenu.classList.remove("active");
        document.body.style.overflow = "";
      });
    });
  }

  // Close everything when clicking outside
  document.addEventListener("click", () => {
    if (langBtn) langBtn.setAttribute("aria-expanded", "false");
  });
</script>
