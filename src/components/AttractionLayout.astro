---
import Layout from "../layouts/Layout.astro";
import Navbar from "./navbar.astro";
import ContactForm from "./ContactForm.astro";

interface Props {
  title: string;
  desc: string;
  image: string;
  dist?: string;
  slug: string;
  lang: string;
  category: string;
}

const { title, desc, image, dist, slug, lang, category } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const categoryLabel = category === "urbano"
  ? (lang === "es" ? "Circuito Urbano" : lang === "en" ? "Urban Circuit" : "城市环线")
  : (lang === "es" ? "Imperdibles" : lang === "en" ? "Must-Sees" : "必看景点");
const categorySlug = category === "urbano" ? "circuito-urbano" : "imperdibles";
const backLabel = lang === "es" ? "Volver a ¿Qué hacer?" : lang === "en" ? "Back to What to do?" : "返回做什么？";
const readMoreLabel = lang === "es" ? "Tiempo de lectura: 3 min" : lang === "en" ? "Reading time: 3 min" : "阅读时间：3分钟";
---

<Layout
  title={`${title} | Departamentos Costanera`}
  description={desc}
  ogImage={image}
>
  <Navbar />
  <main class="attraction-page">
    <div class="attraction-hero">
      <img src={`${baseUrl}${image}`} alt={title} class="attraction-hero-img" />
      <div class="attraction-hero-overlay">
        <div class="container">
          <nav class="breadcrumb">
            <a href={`${baseUrl}/${lang}/que-hacer`}>{backLabel}</a>
            <span class="sep">/</span>
            <a href={`${baseUrl}/${lang}/que-hacer#${categorySlug}`}>{categoryLabel}</a>
            <span class="sep">/</span>
            <span>{title}</span>
          </nav>
          {dist && (
            <span class="attraction-dist">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {dist} {lang === "es" ? "del departamento" : lang === "en" ? "from the apartment" : "从公寓出发"}
            </span>
          )}
          <h1>{title}</h1>
          <p class="attraction-desc">{desc}</p>
        </div>
      </div>
    </div>

    <section class="attraction-content-section">
      <div class="container">
        <div class="attraction-content">
          <slot />
        </div>

        <div class="attraction-footer">
          <a href={`${baseUrl}/${lang}/que-hacer`} class="btn-iridescent">
            <span>{backLabel}</span>
          </a>
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<style>
  .attraction-page {
    padding-bottom: 0;
  }

  .attraction-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 400px;
    overflow: hidden;
  }

  .attraction-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .attraction-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);
    display: flex;
    align-items: flex-end;
    padding: 3rem 0;
  }

  .breadcrumb {
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .breadcrumb a {
    color: var(--soft-apricot);
    text-decoration: none;
    transition: var(--transition);
  }

  .breadcrumb a:hover {
    color: var(--white);
  }

  .breadcrumb .sep {
    margin: 0 0.5rem;
    color: var(--text-muted);
  }

  .attraction-dist {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--soft-apricot);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .attraction-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--white);
    font-weight: 800;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
  }

  .attraction-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    line-height: 1.6;
  }

  .attraction-content-section {
    padding: 4rem 0;
  }

  .attraction-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .attraction-content p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .attraction-footer {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  @media (max-width: 768px) {
    .attraction-hero {
      height: 45vh;
      min-height: 300px;
    }

    .attraction-hero-overlay {
      padding: 2rem 0;
    }

    .attraction-content-section {
      padding: 2.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .attraction-hero {
      height: 35vh;
      min-height: 250px;
    }
  }
</style>
