---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const l = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${lang}${path}`.replace(/\/+$/, "/");
};

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="footer">
  <!-- Main footer grid -->
  <div class="footer-main container">
    <!-- Col 1: Logo + tagline -->
    <div class="footer-brand">
      <a
        href={l("/")}
        class="footer-logo-link"
        aria-label="Departamentos Costanera – Inicio"
      >
        <img
          src={`${baseUrl}/logo.svg`}
          alt="Departamentos Costanera"
          class="footer-logo"
        />
      </a>
      <p class="footer-tagline">
        {t("footer.tagline")}
      </p>
      <!-- Redes sociales -->
      <div class="footer-social">
        <a
          href="https://www.facebook.com/departamentoscostanera"
          class="btn-iridescent-sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/departamentoscostanera"
          class="btn-iridescent-sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
      </div>
    </div>

    <!-- Col 2: Mapa del sitio -->
    <nav class="footer-nav" aria-label={t("footer.map_title") as string}>
      <h3 class="footer-heading">{t("footer.map_title")}</h3>
      <ul class="footer-links">
        <li><a href={l("/")}>{t("nav.inicio")}</a></li>
        <li><a href={l("/departamentos")}>{t("nav.departamentos")}</a></li>
        <li>
          <a
            href="https://direct-book.com/properties/departamentoscostaneradirect"
            target="_blank"
            rel="noopener noreferrer">{t("nav.reservas")}</a
          >
        </li>
        <li><a href={l("/contacto")}>{t("nav.contacto")}</a></li>
      </ul>
    </nav>

    <!-- Col 3: Contáctanos -->
    <div class="footer-contact">
      <h3 class="footer-heading">{t("footer.contact_title")}</h3>
      <ul class="footer-contact-list">
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Mejicana Nº&nbsp;1481, Punta Arenas, Chile</span>
        </li>
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <a href="mailto:contacto@departamentoscostanera.com">
            contacto@departamentoscostanera.com
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 4: Métodos de pago -->
    <div class="footer-pay">
      <h3 class="footer-heading">{t("footer.payment_title")}</h3>
      <img
        src={`${baseUrl}/paylogos.svg`}
        alt="Métodos de pago aceptados"
        class="footer-paylogos"
      />
    </div>
  </div>

  <!-- Partner Logos -->
  <div class="footer-partners container">
    <h3 class="footer-heading center">{t("footer.partners_title")}</h3>
    <div class="partners-grid">
      <div class="partner-logo" style={`background-image: url(${baseUrl}/crece-sostenible.svg)`} role="img" aria-label="Crece Sostenible"></div>
      <div class="partner-logo" style={`background-image: url(${baseUrl}/escnna.svg)`} role="img" aria-label="ESCNNA"></div>
      <div class="partner-logo" style={`background-image: url(${baseUrl}/logo-resimple.svg)`} role="img" aria-label="Resimple"></div>
      <div class="partner-logo" style={`background-image: url(${baseUrl}/sernatur.svg)`} role="img" aria-label="Sernatur"></div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span class="footer-copy">
        {t("footer.rights")}
      </span>
      <span class="footer-powered">
        {t("footer.powered_by")}
        <a href="https://gestoo.cl" target="_blank" rel="noopener noreferrer"
          >Gestoo Agencia Creativa</a
        >
      </span>
    </div>
  </div>
</footer>

<style>
  /* ── Footer shell ─────────────────────────────────────────── */
  .footer {
    background: var(--espresso);
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* ── Main grid ────────────────────────────────────────────── */
  .footer-main {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.4fr 1.4fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ── Brand column ─────────────────────────────────────────── */
  .footer-logo-link {
    display: inline-flex;
    margin-bottom: 1rem;
  }

  .footer-logo {
    height: 44px;
    width: auto;
  }

  .footer-tagline {
    color: #ffffff;
    max-width: 240px;
    font-size: 0.875rem;
  }

  /* ── Column headings ──────────────────────────────────────── */
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft-apricot);
    margin-bottom: 1.25rem;
  }

  /* ── Sitemap links ────────────────────────────────────────── */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: #ffffff;
    transition:
      color 0.25s ease,
      padding-left 0.25s ease;
  }

  .footer-links a:hover {
    color: var(--soft-apricot);
    padding-left: 4px;
  }

  /* ── Contact list ─────────────────────────────────────────── */
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #ffffff;
  }

  .footer-contact-list svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: #ffffff;
  }

  .footer-contact-list a {
    color: #ffffff;
    word-break: break-all;
  }

  .footer-contact-list a:hover {
    color: var(--soft-apricot);
  }

  /* ── Pay logos ────────────────────────────────────────────── */
  .footer-paylogos {
    max-width: 220px;
    width: 100%;
    height: auto;
  }

  /* ── Bottom bar ───────────────────────────────────────────── */
  .footer-bottom {
    background: rgba(0, 0, 0, 0.2);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-copy {
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-powered {
    font-size: 0.8rem;
    color: #ffffff;
  }

  .footer-powered a {
    color: #ffffff;
    font-weight: 600;
  }

  .footer-powered a:hover {
    color: var(--soft-apricot);
  }

  /* ── Social icons ─────────────────────────────────────────── */
  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-paylogos {
      max-width: 180px;
    }

    .partners-grid {
      gap: 1.5rem;
    }

    .partner-logo {
      height: 25px;
      max-width: 100px;
    }
  }

  /* ── Partners Section ──────────────────────────────────────── */
  .footer-partners {
    padding-bottom: 3.5rem;
    text-align: center;
  }

  .footer-heading.center {
    text-align: center;
    margin-bottom: 2rem;
  }

  .partners-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 3rem;
  }

  .partner-logo {
    width: 160px;
    height: 55px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transition: var(--transition);
    filter: brightness(1.1);
  }

  .partner-logo:hover {
    filter: brightness(1.3) scale(1.05);
  }
</style>
