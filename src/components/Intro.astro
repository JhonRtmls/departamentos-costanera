---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import IntroGallery from "./IntroGallery";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const introImages = [
  { src: `${base}/gallery/U67A9020.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A8631.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A8640.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A8691.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A8757.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A9126.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A9193.jpg`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/U67A9408.jpg`, alt: t("intro.img_alt") as string },
];
---

<section class="intro reveal" id="nosotros">
  <div class="container intro-inner">
    <div class="intro-image">
      <IntroGallery client:load images={introImages} />
    </div>

    <div class="intro-text">
      <span class="intro-tag">{t("intro.tag")}</span>
      <h2>{t("intro.title")}</h2>
      <p>{t("intro.p1")}</p>
      <p>{t("intro.p2")}</p>
      <a href="#galeria" class="intro-cta">{t("intro.cta")}</a>
    </div>
  </div>
</section>

<style>
  .intro {
    padding: 6rem 0;
    background: transparent;
  }

  .intro-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .intro-image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 24px 60px rgba(11, 18, 21, 0.12);
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #e2e8f0;
    transition: transform 0.6s ease;
  }

  .intro-image:hover img {
    transform: scale(1.03);
  }

  /* Decorative accent */
  .intro-image::before {
    content: "";
    position: absolute;
    inset: -12px -12px auto auto;
    width: 60%;
    height: 60%;
    border-top: 3px solid var(--accent);
    border-right: 3px solid var(--accent);
    border-radius: 0 20px 0 0;
    z-index: 1;
    pointer-events: none;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .intro-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .intro-text h2 {
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--title-color);
    line-height: 1.15;
    margin: 0;
  }

  .intro-text p {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-main);
    opacity: 0.95;
  }

  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
    transition: var(--transition);
  }

  .intro-cta:hover {
    color: var(--espresso);
    gap: 0.75rem;
  }

  .intro-cta::after {
    content: "→";
  }

  @media (max-width: 768px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .intro-image {
      aspect-ratio: 16 / 9;
    }

    .intro-image::before {
      display: none;
    }
  }
</style>
