---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const introImages = [
  { src: `${base}/gallery/u67a9037.webp`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/u67a8631.webp`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/u67a8640.webp`, alt: t("intro.img_alt") as string },
  { src: `${base}/gallery/u67a8691.webp`, alt: t("intro.img_alt") as string },
];
---

<section class="intro" id="nosotros">
  <div class="container intro-inner">
    <div class="intro-visual reveal">
      <div class="mosaic-container">
        <div class="mosaic-item main">
          <img src={introImages[0].src} alt={introImages[0].alt} loading="lazy" decoding="async" />
        </div>
        <div class="mosaic-item secondary">
          <img src={introImages[1].src} alt={introImages[1].alt} loading="lazy" decoding="async" />
        </div>
        <div class="mosaic-item tertiary">
          <img src={introImages[2].src} alt={introImages[2].alt} loading="lazy" decoding="async" />
        </div>
      </div>
    </div>

    <div class="intro-text reveal" style="animation-delay: 0.2s;">
      <span class="intro-tag">{t("intro.tag")}</span>
      <h2>{t("intro.title")}</h2>
      <p>{t("intro.p1")}</p>
      <p>{t("intro.p2")}</p>
      <a href="#galeria" class="intro-cta">{t("intro.cta")}</a>
    </div>
  </div>
</section>

<style>
  .intro {
    padding: 8rem 0;
    background: transparent;
    overflow: hidden;
    content-visibility: auto;
    contain-intrinsic-size: 0 700px;
  }

  .intro-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  /* ── Mosaic Composition ── */
  .intro-visual {
    position: relative;
    height: 600px;
  }

  .mosaic-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .mosaic-item {
    position: absolute;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mosaic-item.main {
    width: 75%;
    height: 85%;
    top: 0;
    left: 0;
    z-index: 2;
  }

  .mosaic-item.secondary {
    width: 50%;
    height: 50%;
    bottom: 0;
    right: 0;
    z-index: 3;
    border: 4px solid var(--bg-body);
  }

  .mosaic-item.tertiary {
    width: 35%;
    height: 35%;
    top: 15%;
    right: -5%;
    z-index: 1;
    opacity: 0.6;
    filter: blur(1px);
  }

  .mosaic-item:hover {
    transform: translateY(-10px) scale(1.02);
    z-index: 10;
  }

  /* ── Intro Text ── */
  .intro-tag {
    display: block;
    color: var(--soft-apricot);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .intro-text h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 2rem;
    color: #ffffff;
  }

  .intro-text p {
    font-size: 1.15rem;
    color: var(--text-main);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .intro-cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 1rem 2.5rem;
    background: var(--espresso);
    color: #ffffff;
    font-weight: 700;
    border-radius: 50px;
    transition: var(--transition);
    box-shadow: 0 10px 30px rgba(178, 89, 61, 0.3);
  }

  .intro-cta:hover {
    transform: translateY(-3px);
    background: var(--muted-terracotta);
    box-shadow: 0 15px 40px rgba(178, 89, 61, 0.4);
  }

  @media (max-width: 1024px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: 4rem;
      text-align: center;
    }

    .intro-visual {
      height: 500px;
      order: 2;
    }

    .mosaic-item.tertiary {
      display: none;
    }
    
    .intro-cta {
      margin: 1.5rem auto 0;
    }
  }

  @media (max-width: 768px) {
    .intro {
      padding: 5rem 0;
    }
    .intro-visual {
      height: 400px;
    }
  }
</style>
