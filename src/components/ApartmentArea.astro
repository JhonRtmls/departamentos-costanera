---
interface Props {
  title: string;
  description: string;
  images: string[];
  reverse?: boolean;
  tag?: string;
  logo?: string;
  logoAlt?: string;
}

const { title, description, images, reverse = false, tag, logo, logoAlt } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const mainImage = images[0];
const thumbImages = images.slice(1, 4);
---

<section class={`area-section ${reverse ? "reverse" : ""}`}>
  <div class="container area-grid">
    <div class="area-content reveal">
      {tag && <span class="area-tag">{tag}</span>}
      <h2 class="area-title">{title}</h2>
      <p class="area-description">{description}</p>
    </div>

    <div class="area-gallery reveal" style="animation-delay: 0.2s;">
      <div class="gallery-main">
        {
          mainImage && (
            <img
              src={`${baseUrl}/gallery/${mainImage}`}
              alt={title}
              loading="lazy"
            />
          )
        }
      </div>
      {
        thumbImages.length > 0 && (
          <div class="gallery-thumbs">
            {thumbImages.map((img: string) => (
              <div class="thumb">
                <img
                  src={`${baseUrl}/gallery/${img}`}
                  alt={title}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        )
      }
      {
        logo && (
          <div class="gallery-logo">
            <img
              src={`${baseUrl}/${logo}`}
              alt={logoAlt || ''}
              loading="lazy"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .area-section {
    padding: 6rem 0;
    overflow: hidden;
  }

  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }

  .area-section.reverse .area-grid {
    grid-template-columns: 1.2fr 1fr;
  }

  .area-section.reverse .area-content {
    order: 2;
  }

  .area-section.reverse .area-gallery {
    order: 1;
  }

  .area-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .area-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--white);
    margin-bottom: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .area-description {
    color: var(--text-main);
    font-size: 1.1rem;
    line-height: 1.7;
    opacity: 0.9;
  }

  /* Gallery Styling */
  .area-gallery {
    display: grid;
    gap: 1rem;
  }

  .gallery-main {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .thumb {
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .area-gallery:hover img {
    transform: scale(1.05);
  }

  .gallery-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gallery-logo img {
    max-height: 50px;
    width: auto;
    object-fit: contain;
    filter: brightness(1.1);
    transition: transform 0.4s ease;
  }

  .gallery-logo:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 992px) {
    .area-grid,
    .area-section.reverse .area-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .area-section.reverse .area-content,
    .area-section.reverse .area-gallery {
      order: unset;
    }

    .area-section {
      padding: 4rem 0;
    }
  }

  @media (max-width: 480px) {
    .gallery-thumbs {
      gap: 0.5rem;
    }
    .area-section {
      padding: 3rem 0;
    }
    .area-description {
      font-size: 1rem;
    }
    .gallery-main {
      border-radius: 16px;
    }
    .thumb {
      border-radius: 10px;
    }
  }
</style>
