---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tag = t("map.tag");
const title = t("map.title");
const subtitle = t("map.subtitle");
const address = t("contact.address");
const phone = t("contact.phone");
const email = t("contact.email");

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const mapImg = `${base}/mapa-1.jpeg`;
---

<section class="map-section reveal" id="ubicacion">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{tag}</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
  </div>

  <div class="map-wrapper">
    <a
      href="https://maps.app.goo.gl/z2PdT1GQfqDoyKWB6"
      target="_blank"
      rel="noopener noreferrer"
      class="map-overlay"
      aria-label="Abrir en Google Maps"
    >
      <span class="map-overlay-hint">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Abrir en Google Maps
      </span>
    </a>

    <img
      src={mapImg}
      alt="Mapa de ubicación"
      width="100%"
      height="450"
      class="static-map"
      loading="lazy"
    />

    <div class="map-info-panel">
      <ul>
        <li>
          <span class="map-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <span>{address}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .map-section {
    padding: 8rem 0 0;
    background: transparent;
    content-visibility: auto;
    contain-intrinsic-size: 0 600px;
  }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.9;
  }
  .section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }
  .section-header p {
    color: var(--text-main);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .map-wrapper {
    position: relative;
    overflow: hidden;
    max-width: 1000px;
    margin: 0 auto;
    border-radius: 32px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }
  .static-map {
    display: block;
    width: 100%;
    height: 500px;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .map-wrapper:hover .static-map {
    transform: scale(1.05);
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .map-overlay-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: var(--espresso);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.8rem 1.6rem;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
  }
  .map-overlay:hover .map-overlay-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .map-info-panel {
    background: #ffffff;
    padding: 2rem;
    border-top: 1px solid rgba(78, 44, 35, 0.1);
  }
  .map-info-panel ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: center;
  }
  .map-info-panel li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--espresso);
    font-size: 1rem;
    font-weight: 500;
  }
  .map-icon {
    color: var(--espresso);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-info-panel a {
    color: var(--espresso);
    text-decoration: none;
    font-weight: 700;
    transition: var(--transition);
  }
  .map-info-panel a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .map-section { padding: 5rem 0 0; }
    .static-map { height: 300px; }
    .map-info-panel { padding: 1.25rem; }
    .map-info-panel ul { gap: 1rem; flex-direction: column; align-items: flex-start; }
    .map-wrapper { border-radius: 20px; }
  }

  @media (max-width: 480px) {
    .static-map { height: 220px; }
    .map-section .section-header { margin-bottom: 2.5rem; }
  }
</style>
