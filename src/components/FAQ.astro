---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
  { q: t("faq.q1"), a: t("faq.a1") },
  { q: t("faq.q2"), a: t("faq.a2") },
  { q: t("faq.q3"), a: t("faq.a3") },
  { q: t("faq.q4"), a: t("faq.a4") },
  { q: t("faq.q5"), a: t("faq.a5") },
  { q: t("faq.q6"), a: t("faq.a6").replace("{{LINK}}", `<a href="/${lang}/que-hacer">${t("nav.que_hacer")}</a>`) },
  { q: t("faq.q7"), a: t("faq.a7") },
  { q: t("faq.q8"), a: t("faq.a8") },
  { q: t("faq.q9"), a: t("faq.a9") },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
};
---

<section class="faq reveal" id="faq">
  <div class="container content-contained">
    <div class="section-header">
      <span class="section-tag">{t("faq.tag")}</span>
      <h2>{t("faq.title")}</h2>
    </div>

    <div class="faq-grid glass-card">
      {
        faqs.map((faq, index) => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false" data-index={index}>
              <span>{faq.q}</span>
              <span class="faq-icon"></span>
            </button>
            <div class="faq-answer">
              <div class="answer-content">
                <p set:html={faq.a}></p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<script>
  function initFAQ() {
    const questions = document.querySelectorAll('.faq-question');

    questions.forEach(question => {
      question.addEventListener('click', () => {
        const expanded = question.getAttribute('aria-expanded') === 'true';

        // Close other items
        questions.forEach(q => {
          if (q !== question) {
            q.setAttribute('aria-expanded', 'false');
            const otherAnswer = q.nextElementSibling as HTMLElement;
            if (otherAnswer) otherAnswer.style.maxHeight = '0';
          }
        });

        // Toggle current item
        question.setAttribute('aria-expanded', (!expanded).toString());
        const answer = question.nextElementSibling as HTMLElement;

        if (!expanded) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
        } else {
          answer.style.maxHeight = '0';
        }
      });
    });
  }

  // Initialize on page load and after Astro transitions
  initFAQ();
  document.addEventListener('astro:after-swap', initFAQ);
</script>

<style>
  .faq {
    padding: 6rem 0;
    background-color: transparent;
    content-visibility: auto;
    contain-intrinsic-size: 0 500px;
  }

  .content-contained {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--title-color);
  }

  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 2.5rem;
  }

  @media (max-width: 768px) {
    .faq-grid {
      padding: 1rem 1.5rem;
    }
    .faq-question {
      font-size: 1rem;
      padding: 1.25rem 0;
    }
    .faq {
      padding: 4rem 0;
    }
  }

  @media (max-width: 480px) {
    .faq-grid {
      padding: 0.75rem 1rem;
    }
    .faq-question {
      font-size: 0.95rem;
      padding: 1rem 0;
    }
  }

  .faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    transition: var(--transition);
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--soft-apricot);
    transition: all 0.3s ease;
  }

  .faq-icon::before {
    width: 100%;
    height: 2px;
  }

  .faq-icon::after {
    width: 2px;
    height: 100%;
  }

  .faq-question[aria-expanded="true"] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-question[aria-expanded="true"] {
    color: var(--white);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .answer-content {
    padding-bottom: 1.5rem;
  }

  .answer-content p {
    color: var(--text-main);
    line-height: 1.6;
    font-size: 1rem;
  }
</style>
