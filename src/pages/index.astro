<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirigiendo...</title>
    <script is:inline>
      // Idiomas soportados
      const supported = ["es", "en", "zh"];

      // Detecta el idioma del navegador (ej: "es-AR", "en-US", "zh-CN")
      const browserLang = (
        navigator.language ||
        navigator.languages?.[0] ||
        "en"
      )
        .toLowerCase()
        .split("-")[0]; // Toma solo el código base: "es", "en", "zh"

      const locale = supported.includes(browserLang) ? browserLang : "en";

      // Redirige usando una ruta relativa para soportar subcarpetas
      window.location.replace("./" + locale + "/");
    </script>
    <noscript>
      <!-- Fallback para navegadores sin JS -->
      <meta http-equiv="refresh" content="0;url=./es/" />
    </noscript>
  </head>
  <body></body>
</html>
