---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("es");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const urbano = [
  {
    image: `${baseUrl}/atracciones/Museo-Sara-Brown-Punta-Arenas.webp`,
    title: "Museo Sara Braun",
    dist: "0.9 km",
    desc: "Histórico inmueble frente a la Plaza Muñoz Gamero, construido entre 1895 y 1905. Declarado monumento nacional.",
  },
  {
    image: `${baseUrl}/atracciones/Monumento-Al-Ovejero-Punta-Arenas-Chile.webp`,
    title: "Monumento al Ovejero",
    dist: "3.5 km",
    desc: "Escultura múltiple con doce figuras a escala natural que rinde homenaje a los trabajadores de la Patagonia.",
  },
  {
    image: `${baseUrl}/atracciones/Museo-Nao-Victoria-Magallanes-Chile.webp`,
    title: "Museo Nao Victoria",
    dist: "7.5 km",
    desc: "Réplicas de embarcaciones históricas como la Nao Victoria y el HMS Beagle, a orillas del estrecho de Magallanes.",
  },
  {
    image: `${baseUrl}/atracciones/Cementerio-Municipal-Atracciones-Punta-Arenas.webp`,
    title: "Cementerio Municipal Sara Braun",
    dist: "1.4 km",
    desc: "Considerado uno de los cementerios más bellos del mundo, con cipreses tallados y mausoleos históricos.",
  },
  {
    image: `${baseUrl}/gallery/costanera-1.webp`,
    title: "Plaza de Armas",
    dist: "0.5 km",
    desc: "El corazón de Punta Arenas, rodeada de edificios patrimoniales y la icónica Fuente de las Águilas.",
  },
  {
    image: `${baseUrl}/gallery/costanera-7.webp`,
    title: "Cerro de la Cruz",
    dist: "1.5 km",
    desc: "Mirador natural con una vista panorámica espectacular de la ciudad y el estrecho de Magallanes.",
  },
  {
    image: `${baseUrl}/gallery/costanera-5.webp`,
    title: "Zona Franca",
    dist: "3 km",
    desc: "Principal centro de compras de la Patagonia con productos libres de impuestos y gran variedad de tiendas.",
  },
  {
    image: `${baseUrl}/gallery/u67a8631.webp`,
    title: "Club Andino",
    dist: "2 km",
    desc: "Centro de actividades de montaña y ski, ideal para los amantes de los deportes de nieve y la aventura.",
  },
  {
    image: `${baseUrl}/gallery/costanera-3.webp`,
    title: "Entorno Patrimonial",
    dist: "0.3 km",
    desc: "Recorrido por las calles del casco histórico con casonas de estilo europeo y fachadas coloridas.",
  },
  {
    image: `${baseUrl}/gallery/u67a9037.webp`,
    title: "Reserva Nacional Magallanes",
    dist: "10 km",
    desc: "Área protegida con senderos rodeados de lengas y coigües, ideal para trekking y avistamiento de aves.",
  },
  {
    image: `${baseUrl}/gallery/costanera-8.webp`,
    title: "Kiosco Roca",
    dist: "0.2 km",
    desc: "Tradicional kiosco patrimonial en la costanera, punto de encuentro para disfrutar la vista al estrecho.",
  },
];

const imperdibles = [
  {
    image: `${baseUrl}/gallery/u67a9608.avif`,
    title: "Parque Nacional Torres del Paine",
    desc: "El parque más emblemático de Chile, famoso por sus imponentes torres de granito, glaciares y una biodiversidad única en el mundo.",
  },
  {
    image: `${baseUrl}/gallery/u67a8867.webp`,
    title: "Parque Nacional Alberto de Agostini",
    desc: "Extenso parque en Tierra del Fuego con glaciares, fiordos y bosques milenarios, ideal para la exploración remota.",
  },
  {
    image: `${baseUrl}/gallery/costanera-10.webp`,
    title: "Parque Nacional Cabo de Hornos",
    desc: "El parque más austral del mundo, declarado Reserva de la Biosfera, con paisajes subantárticos y fauna marina única.",
  },
  {
    image: `${baseUrl}/gallery/u67a9633.webp`,
    title: "Parque Nacional Isla Magdalena",
    desc: "Hogar de una de las colonias de pingüinos más grandes de Sudamérica, accesible en ferry desde Punta Arenas.",
  },
  {
    image: `${baseUrl}/gallery/u67a9408.webp`,
    title: "Parque Nacional Pali Aike",
    desc: "Paisaje volcánico único con cráteres, cuevas de lava y formaciones rocosas que parecen de otro planeta.",
  },
  {
    image: `${baseUrl}/gallery/u67a9576.webp`,
    title: "Parque Nacional Bernardo O'Higgins",
    desc: "El parque más grande de Chile, con el imponente Campo de Hielo Sur y el Glaciar Pío XI, el más grande del hemisferio sur.",
  },
  {
    image: `${baseUrl}/gallery/u67a9316.webp`,
    title: "Parque Marino Francisco Coloane",
    desc: "Santuario marino ideal para avistar ballenas jorobadas, delfines y lobos marinos en su hábitat natural.",
  },
  {
    image: `${baseUrl}/gallery/u67a9009.webp`,
    title: "Tierra del Fuego",
    desc: "Archipiélago al sur del estrecho con paisajes remotos, bosques milenarios, lagos y una rica historia indígena y exploratoria.",
  },
  {
    image: `${baseUrl}/gallery/u67a9281.webp`,
    title: "Parque del Estrecho",
    desc: "Parque histórico que alberga el Fuerte Bulnes, primer asentamiento chileno en el estrecho de Magallanes, con vistas espectaculares.",
  },
  {
    image: `${baseUrl}/gallery/u67a9686.webp`,
    title: "Faro San Isidro",
    desc: "Faro solitario en la costa del estrecho, rodeado de una naturaleza salvaje y una historia llena de naufragios.",
  },
  {
    image: `${baseUrl}/gallery/u67a8691.webp`,
    title: "Pingüino Rey",
    desc: "Colonia de pingüinos rey en la Bahía Inútil, una experiencia única para observar a estas majestuosas aves en libertad.",
  },
];
---

<Layout
  title={`${t("que_hacer.title")} | Departamentos Costanera`}
  description={t("que_hacer.subtitle") as string}
>
  <Navbar />
  <main>
    <SubPageHero
      title={t("que_hacer.title") as string}
      subtitle={t("que_hacer.subtitle") as string}
      tag={t("que_hacer.tag") as string}
    />

    <section class="section urbano" id="circuito-urbano">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Centro Histórico</span>
          <h2>{t("que_hacer.circuito_urbano_title")}</h2>
          <p>{t("que_hacer.circuito_urbano_desc")}</p>
        </div>
        <div class="cards-grid">
          {urbano.map((item, i) => (
            <div class="card glass-card" style={`animation-delay: ${i * 0.05}s;`}>
              <div class="card-image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <div class="card-content">
                <h3>{item.title}</h3>
                <div class="distance-tag">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{item.dist}</span>
                </div>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section imperdibles" id="imperdibles">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Patagonia</span>
          <h2>{t("que_hacer.imperdibles_title")}</h2>
          <p>{t("que_hacer.imperdibles_desc")}</p>
        </div>
        <div class="cards-grid">
          {imperdibles.map((item, i) => (
            <div class="card glass-card" style={`animation-delay: ${i * 0.05}s;`}>
              <div class="card-image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <div class="card-content">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .card {
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    padding: 1rem;
    border-radius: 28px;
  }

  .card:hover {
    transform: translateY(-8px);
    border-color: var(--soft-apricot);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 0 0.5rem 0.5rem;
  }

  .card-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--title-color);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .distance-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--soft-apricot);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .card-content p {
    font-size: 0.88rem;
    color: var(--text-main);
    line-height: 1.6;
    opacity: 0.9;
  }

  .imperdibles .card p {
    margin-top: 0.5rem;
  }

  @media (max-width: 1100px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 3.5rem 0;
    }
    .cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 0.75rem;
    }
    .card-content {
      padding: 0 0.25rem 0.25rem;
    }
  }
</style>
