---
import { getCollection, render } from "astro:content";
import AttractionLayout from "../../../components/AttractionLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("attractions", (e) => e.data.lang === "es");
  return entries.map((e) => ({
    params: { slug: e.id.replace(/^[a-z]{2}\//, "") },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const slug = entry.id.replace(/^[a-z]{2}\//, "");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<AttractionLayout
  title={data.title}
  desc={data.description}
  image={data.image}
  dist={data.dist}
  slug={slug}
  lang="es"
  category={data.category}
>
  <Content />
</AttractionLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": data.title,
  "description": data.description,
  "image": `${baseUrl}${data.image}`,
  "url": `${baseUrl}/es/que-hacer/${slug}/`,
  "audience": { "@type": "Audience", "audienceType": "Tourist" },
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "location": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Punta Arenas",
      "addressRegion": "Magallanes",
      "addressCountry": "CL"
    },
    ...(data.lat && data.lng ? {
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": data.lat,
        "longitude": data.lng
      }
    } : {})
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${baseUrl}/es/?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
})} />
