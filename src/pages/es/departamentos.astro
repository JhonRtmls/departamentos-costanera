---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ApartmentArea from "../../components/ApartmentArea.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Layout
  title="Detalles de los Departamentos | Departamentos Costanera"
  description="Conoce cada rincón de nuestros departamentos: living, habitaciones, cocina y su entorno privilegiado."
>
  <Navbar />
  <main>
    <SubPageHero 
      title="Nuestros Departamentos" 
      subtitle="Explora el confort y la calidad de cada uno de nuestros espacios diseñados para tu estadía."
      tag="Detalles"
    />
    
    <ApartmentArea 
      tag="Espacios Comunes"
      title="Living"
      description="Un espacio amplio y luminoso, diseñado para el relax absoluto con mobiliario moderno y una atmósfera acogedora que te hará sentir como en casa."
      images={['living-1.webp', 'living-2.webp', 'living-3.webp', 'living-4.webp']}
    />

    <ApartmentArea 
      tag="Gastronomía"
      title="Comedor"
      description="Área de comedor integrada y funcional, perfecta para disfrutar de tus comidas en un ambiente elegante y bien iluminado."
      images={['comedor-1.webp', 'comedor-2.webp', 'comedor-3.webp', 'comedor.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Descanso"
      title="Habitaciones"
      description="Dormitorios pensados para un descanso profundo, equipados con ropa de cama premium, calefacción central y un diseño que invita a la calma."
      images={['habitacion-1.webp', 'habitacion-2.webp', 'camas.webp', 'camas-2.webp']}
    />

    <ApartmentArea 
      tag="Funcionalidad"
      title="Cocina"
      description="Totalmente equipada con electrodomésticos de última generación, encimeras modernas y todo lo necesario para preparar tus platos favoritos."
      images={['cocina-1.webp', 'cocina-2.webp', 'cocina-3-thumb.webp', 'cocina-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Bienestar"
      title="Baño"
      description="Baños modernos y minimalistas, con acabados de alta calidad y equipados con amenities premium para tu comodidad diaria."
      images={['bano.webp']}
    />

    <ApartmentArea 
      tag="Seguridad"
      title="Estacionamiento"
      description="Contamos con estacionamiento privado y gratuito dentro del recinto, brindándote la tranquilidad y seguridad que necesitas para tu vehículo."
      images={['estacionamiento-3.webp', 'estacionamiento.webp', 'estacionamiento-2.webp', 'estacionamiento-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Entorno"
      title="La Costanera"
      description="A solo pasos del Estrecho de Magallanes, nuestros departamentos te ofrecen la cercanía ideal para caminatas inolvidables junto al mar."
      images={['costanera-1.webp', 'costanera-2.webp', 'costanera-3.webp', 'costanera-4.webp']}
    />

    <ApartmentArea 
      tag="Recreación"
      title="Parque de los Dinosaurios"
      description="Un espacio recreativo ideal para familias y niños, ubicado a poca distancia de nuestros departamentos, donde la historia y la diversión se encuentran en un entorno natural único."
      images={['plaza-1.webp', 'plaza-2.webp', 'plaza-3.webp', 'plaza-4.webp']}
      reverse={true}
    />

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }
</style>
