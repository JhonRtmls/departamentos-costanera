---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("zh");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${t("promos.tag")} | Departamentos Costanera`}
  description={t("promos.title") as string}
>
  <Navbar />
  <main>
    <SubPageHero
      title={t("promos.tag") as string}
      subtitle={t("promos.title") as string}
    />

    <section class="promos-section">
      <div class="container">
        <p class="promos-intro">{t("promos.subtitle")}</p>

        <div class="promos-grid">
          <div class="promo-card glass-card">
            <div class="promo-image">
              <div class="promo-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg>
              </div>
            </div>
            <div class="promo-body">
              <h3>{t("promos.carnaval_title")}</h3>
              <p class="promo-desc">{t("promos.carnaval_desc")}</p>
              <p class="promo-valid"><strong>有效期：</strong>{t("promos.carnaval_valid")}</p>
              <ul class="promo-notes">
                <li>{t("promos.carnaval_note1")}</li>
                <li>{t("promos.carnaval_note2")}</li>
              </ul>
            </div>
          </div>

          <div class="promo-card glass-card">
            <div class="promo-image">
              <div class="promo-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
            </div>
            <div class="promo-body">
              <h3>{t("promos.tresx2_title")}</h3>
              <p class="promo-desc">{t("promos.tresx2_desc")}</p>
              <ul class="promo-notes">
                <li>{t("promos.tresx2_note1")}</li>
                <li>{t("promos.tresx2_note2")}</li>
                <li>{t("promos.tresx2_note3")}</li>
              </ul>
            </div>
          </div>

          <div class="promo-card glass-card">
            <div class="promo-image">
              <div class="promo-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M3 21v-2a7 7 0 0 1 7-7h4a7 7 0 0 1 7 7v2"/></svg>
              </div>
            </div>
            <div class="promo-body">
              <h3>{t("promos.residentes_title")}</h3>
              <p class="promo-desc">{t("promos.residentes_desc")}</p>
              <p class="promo-valid">{t("promos.residentes_code")}</p>
              <ul class="promo-notes">
                <li>{t("promos.residentes_note1")}</li>
                <li>{t("promos.residentes_note2")}</li>
                <li>{t("promos.residentes_requisito")}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }

  .promos-section {
    padding: 4rem 0;
  }

  .promos-intro {
    text-align: center;
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 3rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .promos-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .promo-card {
    display: flex;
    overflow: hidden;
    transition: var(--transition);
  }

  .promo-card:hover {
    transform: translateY(-4px);
  }

  .promo-image {
    width: 300px;
    min-height: 220px;
    flex-shrink: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promo-placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .promo-body {
    padding: 2rem;
    flex: 1;
  }

  .promo-body h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .promo-desc {
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .promo-valid {
    color: #ffffff;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .promo-notes {
    list-style: disc;
    padding-left: 1.25rem;
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .promo-notes li {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 768px) {
    .promos-section {
      padding: 3rem 0;
    }
    .promo-card {
      flex-direction: column;
    }
    .promo-image {
      width: 100%;
      min-height: 160px;
    }
    .promo-body {
      padding: 1.5rem;
    }
  }
</style>
