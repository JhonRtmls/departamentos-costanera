---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ApartmentArea from "../../components/ApartmentArea.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Layout
  title="公寓详情 | Costanera 公寓"
  description="探索我们公寓的每个角落：客厅、卧室、厨房及其优越的周边环境。"
>
  <Navbar />
  <main>
    <SubPageHero 
      title="我们的公寓" 
      subtitle="探索专为您的住宿而设计的每个空间的舒适与品质。"
      tag="详情"
    />
    
    <ApartmentArea 
      tag="公共空间"
      title="客厅"
      description="宽敞明亮的休息空间，配有现代家具和温馨氛围，让您宾至如归。"
      images={['living-1.webp', 'living-2.webp', 'living-3.webp', 'living-4.webp']}
    />

    <ApartmentArea 
      tag="美食"
      title="用餐区"
      description="集成的多功能餐饮区，非常适合在优雅且采光良好的环境中享用美食。"
      images={['comedor-1.webp', 'comedor-2.webp', 'comedor-3.webp', 'comedor.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="休息"
      title="卧室"
      description="专为深度休息设计的客房，配备高品质床上用品和中央供暖，营造成一个宁静的氛围。"
      images={['habitacion-1.webp', 'habitacion-2.webp', 'camas.webp', 'camas-2.webp']}
    />

    <ApartmentArea 
      tag="功能性"
      title="厨房"
      description="配备先进家电和现代柜台，提供准备您最喜欢的菜肴所需的一切。"
      images={['cocina-1.webp', 'cocina-2.webp', 'cocina-3-thumb.webp', 'cocina-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="健康"
      title="浴室"
      description="现代简约的浴室，采用高品质饰面，并配备优质洗浴用品，为您提供日常舒适。"
      images={['bano.webp']}
    />

    <ApartmentArea 
      tag="安全"
      title="停车场"
      description="院内设有私人免费停车场，为您提供所需的车辆安全保障。"
      images={['estacionamiento-3.webp', 'estacionamiento.webp', 'estacionamiento-2.webp', 'estacionamiento-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="环境"
      title="海滨"
      description="距离麦哲伦海峡仅几步之遥，我们的公寓为您提供海边漫步的理想场所。"
      images={['costanera-1.webp', 'costanera-2.webp', 'costanera-3.webp', 'costanera-4.webp']}
    />

    <ApartmentArea 
      tag="休闲"
      title="恐龙公园"
      description="一个适合家庭和儿童的理想休闲空间，距离我们的公寓仅几步之遥，是历史与乐趣在独特的自然环境中交汇的地方。"
      images={['plaza-1.webp', 'plaza-2.webp', 'plaza-3.webp', 'plaza-4.webp']}
      reverse={true}
    />

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }
</style>
