---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import Hero from "../../components/Hero.astro";
import Intro from "../../components/Intro.astro";
import Gallery from "../../components/Gallery.astro";
import Services from "../../components/Services.astro";
import Sustainability from "../../components/Sustainability.astro";
import Map from "../../components/Map.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("zh");
---

<Layout title="Costanera 公寓 | 蓬塔阿雷纳斯" description={t("home.welcome") as string}>
  <Navbar />
  <main>
    <Hero />
    <Intro />
    <Gallery />
    <Services />
    <Sustainability />
    <section class="policies container" id="politicas">
      <span class="section-tag">{t("policies.tag")}</span>
      <h2>{t("policies.title")}</h2>
      <p>{t("policies.desc")}</p>
    </section>
    <Map />
    <ContactForm />
  </main>
</Layout>

<style>
  .policies {
    padding: 5rem 0;
    text-align: center;
  }
  .section-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .policies h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }
  .policies p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto;
  }
</style>
