---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${t("promos.tag")} | Departamentos Costanera`}
  description={t("promos.title") as string}
>
  <Navbar />
  <main>
    <SubPageHero
      title={t("promos.tag") as string}
      subtitle={t("promos.title") as string}
    />

    <section class="promos-section">
      <div class="container">
        <p class="promos-intro">{t("promos.subtitle")}</p>

        <div class="promos-grid">
          <div class="promo-card glass-card">
            <div class="promo-image">
              <img src={`${baseUrl}/promos/carnaval_de_invierno.webp`} alt={t("promos.carnaval_title") as string} class="promo-img" loading="lazy" />
            </div>
            <div class="promo-body">
              <h3>{t("promos.carnaval_title")}</h3>
              <p class="promo-desc">{t("promos.carnaval_desc")}</p>
              <p class="promo-valid"><strong>Valid:</strong> {t("promos.carnaval_valid")}</p>
              <ul class="promo-notes">
                <li>{t("promos.carnaval_note1")}</li>
                <li>{t("promos.carnaval_note2")}</li>
              </ul>
            </div>
          </div>

          <div class="promo-card glass-card">
            <div class="promo-image">
              <img src={`${baseUrl}/promos/promo2.webp`} alt="3x2" class="promo-img" loading="lazy" />
            </div>
            <div class="promo-body">
              <h3>{t("promos.tresx2_title")}</h3>
              <p class="promo-desc">{t("promos.tresx2_desc")}</p>
              <ul class="promo-notes">
                <li>{t("promos.tresx2_note1")}</li>
                <li>{t("promos.tresx2_note2")}</li>
                <li>{t("promos.tresx2_note3")}</li>
              </ul>
            </div>
          </div>

          <div class="promo-card glass-card">
            <div class="promo-image">
              <img src={`${baseUrl}/promos/residentes.webp`} alt={t("promos.residentes_title") as string} class="promo-img" loading="lazy" />
            </div>
            <div class="promo-body">
              <h3>{t("promos.residentes_title")}</h3>
              <p class="promo-desc">{t("promos.residentes_desc")}</p>
              <p class="promo-valid">{t("promos.residentes_code")}</p>
              <ul class="promo-notes">
                <li>{t("promos.residentes_note1")}</li>
                <li>{t("promos.residentes_note2")}</li>
                <li>{t("promos.residentes_requisito")}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }

  .promos-section {
    padding: 4rem 0;
  }

  .promos-intro {
    text-align: center;
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 3rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .promos-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .promo-card {
    display: flex;
    overflow: hidden;
    transition: var(--transition);
  }

  .promo-card:hover {
    transform: translateY(-4px);
  }

  .promo-image {
    width: 500px;
    min-height: 370px;
    flex-shrink: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .promo-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .promo-placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .promo-body {
    padding: 2.4rem;
    flex: 1;
  }

  .promo-body h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .promo-desc {
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .promo-valid {
    color: #ffffff;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .promo-notes {
    list-style: disc;
    padding-left: 1.25rem;
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .promo-notes li {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 768px) {
    .promos-section {
      padding: 3rem 0;
    }
    .promo-card {
      flex-direction: column;
    }
    .promo-image {
      width: 100%;
      min-height: 192px;
    }
    .promo-body {
      padding: 1.8rem;
    }
  }
</style>
