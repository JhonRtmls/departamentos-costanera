---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ApartmentArea from "../../components/ApartmentArea.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Layout
  title="Apartment Details | Costanera Apartments"
  description="Explore every corner of our apartments: living room, bedrooms, kitchen, and its privileged surroundings."
>
  <Navbar />
  <main>
    <SubPageHero 
      title="Our Apartments" 
      subtitle="Explore the comfort and quality of each of our spaces designed for your stay."
      tag="Details"
    />
    
    <ApartmentArea 
      tag="Common Spaces"
      title="Living Room"
      description="A spacious and bright area, designed for absolute relaxation with modern furniture and a cozy atmosphere that will make you feel at home."
      images={['living-6.webp', 'living-2.webp', 'living-3.webp', 'living-5.webp']}
    />

    <ApartmentArea 
      tag="Gastronomy"
      title="Dining Area"
      description="Integrated and functional dining area, perfect for enjoying your meals in an elegant and well-lit environment."
      images={['comedor-1.webp', 'comedor-2.webp', 'comedor-3.webp', 'comedor.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Rest"
      title="Bedrooms"
      description="Rooms designed for deep rest, equipped with premium bedding, central heating, and a design that invites tranquility."
      images={['habitacion-1.webp', 'habitacion-2.webp', 'camas.webp', 'camas-2.webp']}
    />

    <ApartmentArea 
      tag="Functionality"
      title="Kitchen"
      description="Fully equipped with state-of-the-art appliances, modern countertops, and everything needed to prepare your favorite dishes."
      images={['cocina-1.webp', 'cocina-2.webp', 'cocina-3-thumb.webp', 'cocina-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Wellness"
      title="Bathroom"
      description="Modern and minimalist bathrooms, with high-quality finishes and equipped with premium amenities for your daily comfort."
      images={['bano.webp', 'bano-2.webp', 'bano-3-thumb.webp']}
    />

    <ApartmentArea 
      tag="Security"
      title="Parking"
      description="We have private and free parking within the premises, providing you with the peace of mind and security you need for your vehicle."
      images={['estacionamiento-3.webp', 'estacionamiento.webp', 'estacionamiento-2.webp', 'estacionamiento-4.webp']}
      reverse={true}
    />

    <ApartmentArea 
      tag="Surroundings"
      title="The Waterfront"
      description="Just steps from the Strait of Magellan, our apartments offer the ideal proximity for unforgettable walks by the sea."
      images={['costanera-1.webp', 'costanera-2.webp', 'costanera-3.webp', 'costanera-4.webp']}
    />

    <ApartmentArea 
      tag="Recreation"
      title="Dinosaur Park"
      description="An ideal recreational space for families and children, located a short distance from our apartments, where history and fun meet in a unique natural setting."
      images={['plaza-1.webp', 'plaza-2.webp', 'plaza-3.webp', 'plaza-4.webp']}
      reverse={true}
    />

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }
</style>
