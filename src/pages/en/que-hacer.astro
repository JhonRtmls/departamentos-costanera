---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const urbano = [
  {
    image: `${baseUrl}/atracciones/Museo-Sara-Brown-Punta-Arenas.webp`,
    title: "Sara Braun Museum",
    dist: "0.9 km",
    desc: "Historic building facing Plaza Muñoz Gamero, built between 1895 and 1905. Declared a national monument.",
  },
  {
    image: `${baseUrl}/atracciones/Monumento-Al-Ovejero-Punta-Arenas-Chile.webp`,
    title: "Shepherd Monument",
    dist: "3.5 km",
    desc: "A multiple sculpture with twelve life-size figures honoring the workers of Patagonia.",
  },
  {
    image: `${baseUrl}/atracciones/Museo-Nao-Victoria-Magallanes-Chile.webp`,
    title: "Nao Victoria Museum",
    dist: "7.5 km",
    desc: "Replicas of historic ships including the Nao Victoria and HMS Beagle, on the shores of the Strait of Magellan.",
  },
  {
    image: `${baseUrl}/atracciones/Cementerio-Municipal-Atracciones-Punta-Arenas.webp`,
    title: "Sara Braun Municipal Cemetery",
    dist: "1.4 km",
    desc: "Considered one of the most beautiful cemeteries in the world, with carved cypress trees and historic mausoleums.",
  },
  {
    image: `${baseUrl}/gallery/costanera-1.webp`,
    title: "Plaza de Armas",
    dist: "0.5 km",
    desc: "The heart of Punta Arenas, surrounded by heritage buildings and the iconic Eagle Fountain.",
  },
  {
    image: `${baseUrl}/gallery/costanera-7.webp`,
    title: "Cerro de la Cruz",
    dist: "1.5 km",
    desc: "Natural viewpoint offering a spectacular panoramic view of the city and the Strait of Magellan.",
  },
  {
    image: `${baseUrl}/gallery/costanera-5.webp`,
    title: "Zona Franca",
    dist: "3 km",
    desc: "Patagonia's main shopping center with duty-free products and a wide variety of stores.",
  },
  {
    image: `${baseUrl}/gallery/u67a8631.webp`,
    title: "Andino Club",
    dist: "2 km",
    desc: "Mountain and ski activity center, ideal for snow sports and adventure enthusiasts.",
  },
  {
    image: `${baseUrl}/gallery/costanera-3.webp`,
    title: "Heritage District",
    dist: "0.3 km",
    desc: "Walk through the streets of the historic center with European-style mansions and colorful facades.",
  },
  {
    image: `${baseUrl}/gallery/u67a9037.webp`,
    title: "Magallanes National Reserve",
    dist: "10 km",
    desc: "Protected area with trails surrounded by lenga and coigüe trees, ideal for trekking and bird watching.",
  },
  {
    image: `${baseUrl}/gallery/costanera-8.webp`,
    title: "Kiosco Roca",
    dist: "0.2 km",
    desc: "Traditional heritage kiosk on the waterfront, a meeting point to enjoy the view of the strait.",
  },
];

const imperdibles = [
  {
    image: `${baseUrl}/gallery/u67a9608.avif`,
    title: "Torres del Paine National Park",
    desc: "Chile's most iconic park, famous for its towering granite peaks, glaciers, and world-class biodiversity.",
  },
  {
    image: `${baseUrl}/gallery/u67a8867.webp`,
    title: "Alberto de Agostini National Park",
    desc: "Vast park in Tierra del Fuego with glaciers, fjords, and ancient forests, ideal for remote exploration.",
  },
  {
    image: `${baseUrl}/gallery/costanera-10.webp`,
    title: "Cabo de Hornos National Park",
    desc: "The southernmost national park in the world, a Biosphere Reserve with subantarctic landscapes and unique marine life.",
  },
  {
    image: `${baseUrl}/gallery/u67a9633.webp`,
    title: "Isla Magdalena National Park",
    desc: "Home to one of the largest penguin colonies in South America, accessible by ferry from Punta Arenas.",
  },
  {
    image: `${baseUrl}/gallery/u67a9408.webp`,
    title: "Pali Aike National Park",
    desc: "Unique volcanic landscape with craters, lava caves, and rock formations that look like another planet.",
  },
  {
    image: `${baseUrl}/gallery/u67a9576.webp`,
    title: "Bernardo O'Higgins National Park",
    desc: "Chile's largest park, home to the Southern Patagonian Ice Field and Glacier Pío XI, the largest in the southern hemisphere.",
  },
  {
    image: `${baseUrl}/gallery/u67a9316.webp`,
    title: "Francisco Coloane Marine Park",
    desc: "Marine sanctuary ideal for spotting humpback whales, dolphins, and sea lions in their natural habitat.",
  },
  {
    image: `${baseUrl}/gallery/u67a9009.webp`,
    title: "Tierra del Fuego",
    desc: "Archipelago south of the strait with remote landscapes, ancient forests, lakes, and rich indigenous history.",
  },
  {
    image: `${baseUrl}/gallery/u67a9281.webp`,
    title: "Strait Park",
    desc: "Historic park home to Fuerte Bulnes, the first Chilean settlement on the Strait of Magellan, with spectacular views.",
  },
  {
    image: `${baseUrl}/gallery/u67a9686.webp`,
    title: "San Isidro Lighthouse",
    desc: "Lonely lighthouse on the strait coast, surrounded by wild nature and a history full of shipwrecks.",
  },
  {
    image: `${baseUrl}/gallery/u67a8691.webp`,
    title: "King Penguin",
    desc: "King penguin colony in Bahía Inútil, a unique experience to observe these majestic birds in the wild.",
  },
];
---

<Layout
  title={`${t("que_hacer.title")} | Departamentos Costanera`}
  description={t("que_hacer.subtitle") as string}
>
  <Navbar />
  <main>
    <SubPageHero
      title={t("que_hacer.title") as string}
      subtitle={t("que_hacer.subtitle") as string}
      tag={t("que_hacer.tag") as string}
    />

    <section class="section urbano" id="circuito-urbano">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Historic Center</span>
          <h2>{t("que_hacer.circuito_urbano_title")}</h2>
          <p>{t("que_hacer.circuito_urbano_desc")}</p>
        </div>
        <div class="cards-grid">
          {urbano.map((item, i) => (
            <div class="card glass-card" style={`animation-delay: ${i * 0.05}s;`}>
              <div class="card-image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <div class="card-content">
                <h3>{item.title}</h3>
                <div class="distance-tag">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{item.dist}</span>
                </div>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section imperdibles" id="imperdibles">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Patagonia</span>
          <h2>{t("que_hacer.imperdibles_title")}</h2>
          <p>{t("que_hacer.imperdibles_desc")}</p>
        </div>
        <div class="cards-grid">
          {imperdibles.map((item, i) => (
            <div class="card glass-card" style={`animation-delay: ${i * 0.05}s;`}>
              <div class="card-image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <div class="card-content">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .card {
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    padding: 1rem;
    border-radius: 28px;
  }

  .card:hover {
    transform: translateY(-8px);
    border-color: var(--soft-apricot);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 0 0.5rem 0.5rem;
  }

  .card-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--title-color);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .distance-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--soft-apricot);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .card-content p {
    font-size: 0.88rem;
    color: var(--text-main);
    line-height: 1.6;
    opacity: 0.9;
  }

  .imperdibles .card p {
    margin-top: 0.5rem;
  }

  @media (max-width: 1100px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 3.5rem 0;
    }
    .cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 0.75rem;
    }
    .card-content {
      padding: 0 0.25rem 0.25rem;
    }
  }
</style>
