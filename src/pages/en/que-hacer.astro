---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import SubPageHero from "../../components/SubPageHero.astro";
import ApartmentArea from "../../components/ApartmentArea.astro";
import Attractions from "../../components/Attractions.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${t("que_hacer.title")} | Departamentos Costanera`}
  description={t("que_hacer.subtitle") as string}
>
  <Navbar />
  <main>
    <SubPageHero 
      title={t("que_hacer.title") as string} 
      subtitle={t("que_hacer.subtitle") as string}
      tag={t("que_hacer.tag") as string}
    />
    
    <ApartmentArea 
      tag="Historic Center"
      title={t("que_hacer.circuito_urbano_title") as string}
      description={t("que_hacer.circuito_urbano_desc") as string}
      images={[
        `${baseUrl}/atracciones/Museo-Sara-Brown-Punta-Arenas.webp`,
        `${baseUrl}/atracciones/Monumento-Al-Ovejero-Punta-Arenas-Chile.webp`
      ]}
    />

    <ul class="circuito-urbano-list">
      <li>Parque del Estrecho</li>
      <li>Club Andino</li>
      <li>Reserva Nacional Magallanes</li>
      <li>Cerro de la Cruz</li>
      <li>Zona Franca</li>
      <li>Museo Nao Victoria</li>
      <li>Cementerio de Punta Arenas</li>
      <li>Plaza de Armas</li>
      <li>Entorno patrimonial</li>
      <li>Monumento al Ovejero</li>
    </ul>

    <ApartmentArea 
      tag="Patagonia"
      title={t("que_hacer.imperdibles_title") as string}
      description={t("que_hacer.imperdibles_desc") as string}
      images={[
        `${baseUrl}/atracciones/Museo-Nao-Victoria-Magallanes-Chile.webp`,
        `${baseUrl}/atracciones/Cementerio-Municipal-Atracciones-Punta-Arenas.webp`
      ]}
      reverse={true}
    />

    <Attractions />
    <ContactForm />
  </main>
</Layout>

<style>
  main {
    padding-bottom: 4rem;
  }
  .circuito-urbano-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
    max-width: 800px;
    margin: -3rem auto 0;
    padding: 2rem 2.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .circuito-urbano-list li {
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }
  .circuito-urbano-list li::before {
    content: "•";
    color: var(--soft-apricot);
    position: absolute;
    left: 0.5rem;
  }
</style>
